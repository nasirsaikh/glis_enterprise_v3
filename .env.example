# GLIS local/deployment environment example
# Copy to .env and replace development placeholders. Never commit real secrets.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

DATABASE_ENGINE=sqlite
DATABASE_NAME=db.sqlite3
DATABASE_HOST=
DATABASE_PORT=1433
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_DRIVER=ODBC Driver 18 for SQL Server
DATABASE_EXTRA_PARAMS=TrustServerCertificate=yes

ALLAUTH_EMAIL_VERIFICATION=optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# General/local analytics AI
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CONTEXT_WINDOW=8192
OLLAMA_TEMPERATURE=0.1
VANNA_DB_SCHEMA=main
CHROMA_PERSIST_DIRECTORY=data/chroma

# Automated TPA endorsement mailbox — Microsoft Graph
TPA_MAIL_PROVIDER=office365_graph
TPA_MAIL_ENABLED=True
TPA_MAIL_AUTO_PROCESS_AI=True
TPA_MAIL_MAX_MESSAGES_PER_RUN=50
TPA_MAIL_SYNC_CRON=*/5 * * * *
TPA_MAIL_ACTOR_USERNAME=
TPA_EMAIL_CLASSIFICATION_MIN_CONFIDENCE=0.75

TPA_O365_TENANT_ID=
TPA_O365_CLIENT_ID=
TPA_O365_CLIENT_SECRET=
TPA_O365_MAILBOX=
TPA_O365_FOLDER=Inbox
TPA_O365_RECEIVED_AFTER=
TPA_O365_TIMEOUT_SECONDS=60

# Legacy IMAP fallback only (not the primary Office 365 integration)
TPA_IMAP_HOST=
TPA_IMAP_PORT=993
TPA_IMAP_USERNAME=
TPA_IMAP_PASSWORD=
TPA_IMAP_FOLDER=INBOX
TPA_IMAP_USE_SSL=1

# Optional Mayan EDMS
MAYAN_ENABLED=False
MAYAN_BASE_URL=http://127.0.0.1:8090
MAYAN_API_TOKEN=
MAYAN_API_USERNAME=
MAYAN_API_PASSWORD=
MAYAN_VERIFY_SSL=True
MAYAN_TIMEOUT=45
MAYAN_UPLOAD_PATH=
MAYAN_SEARCH_PATH=/api/v4/search/search_models/documents.Document/
MAYAN_DOWNLOAD_PATH=/api/v4/documents/{document_id}/files/1/download/
MAYAN_DOCUMENT_UI_PATH=/#/documents/{document_id}/

SECURE_SSL_REDIRECT=False
SECURE_HSTS_PRELOAD=False

# Local full-page OCR recovery for missing extracted member fields.
TPA_DOCLING_FALLBACK_ENABLED=1
TPA_DOCLING_USE_GPU=0
TPA_DOCLING_TIMEOUT=180
TPA_DOCLING_MAX_PAGES=50
